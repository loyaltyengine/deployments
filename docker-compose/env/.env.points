SPRING_APPLICATION_NAME=points-service

# Database
SPRING_DATASOURCE_URL=jdbc:postgresql://points-service-db:5432/le_points
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=password

# JPA
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true

# gRPC Server
SPRING_GRPC_SERVER_PORT=9090

# gRPC Client
SPRING_GRPC_CLIENT_CHANNEL_COUPONS-SERVICE_TARGET=static://coupons-service:9091
SPRING_GRPC_CLIENT_CHANNEL_COUPONS-SERVICE_BYPASS-CERTIFICATE-VALIDATION=true

# Server
SERVER_PORT=8080

COUPONS_SERVICE_API_URL=http://coupons-service:8081