PORT=3001
NODE_ENV=production

DATABASE_URL = "postgresql://postgres:password@auth-service-db:5432/le_auth"
# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Google OAuth
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
